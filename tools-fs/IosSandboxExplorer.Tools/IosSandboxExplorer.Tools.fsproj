<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>IosSandboxExplorer</RootNamespace>
    <AssemblyName>IosSandboxExplorer.Tools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Client.fs" />
    <Compile Include="MachO.fs" />
    <Compile Include="Patcher.fs" />
    <Compile Include="AppleTls.fs" />
    <Compile Include="Anisette.fs" />
    <Compile Include="AppleCrypto.fs" />
    <Compile Include="AppleSign.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="plist-cil" Version="2.2.0" />
  </ItemGroup>

</Project>
